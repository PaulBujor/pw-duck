#!/usr/bin/env python3
"""pw-duck: sidechain ducking for PipeWire / PulseAudio.

Lower the volume of one or more apps (--target) while something else is making
sound: another app's playback (--output), a microphone being used by an app
(--input), or a capture device (--input-device). A hold time keeps the duck
engaged across short pauses, then the volume fades back up.

  pw-duck --output zoom --input zoom --target tidal-hifi

Settings come from ~/.config/pw-duck/config.ini (see --show-config), and any
command-line option overrides the file. `pw-duck --calibrate-guided` measures
your mic and saves the threshold to the config; a running pw-duck picks up
config changes by itself. Find application names with `pw-duck --list`.

Needs only Python 3.8+ and the `pactl` / `parec` tools (pipewire-pulse or pulseaudio).
"""
import argparse
import array
import collections
import configparser
import json
import math
import os
import shutil
import signal
import subprocess
import sys
import threading
import time

RATE = 16000
CHUNK_MS = 20
CHUNK_BYTES = RATE * 2 * CHUNK_MS // 1000  # s16le mono
TICK = 0.05                                # control-loop period while idle, seconds
RAMP_TICK = 0.02                           # control-loop period while fading (finer = smoother)
SCAN_EVERY = 1.0                           # how often to re-read the stream graph and the config

EASINGS = {
    "linear": lambda f: f,
    "smooth": lambda f: f * f * (3 - 2 * f),   # smoothstep: gentle start and end
}

CONFIG_SECTION = "pw-duck"
# Settings that may live in the config file. `list` values are comma-separated.
CONFIG_KEYS = {
    "target": list, "output": list, "input": list, "input-device": list,
    "duck-db": float, "output-threshold-db": float, "input-threshold-db": float,
    "input-sustain-ms": float, "hold": float, "attack": float, "release": float,
    "easing": str,
}


def default_config_path():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "pw-duck", "config.ini")


DEFAULTS = {
    "target": [], "output": [], "input": [], "input_device": [],
    "duck_db": -12.0, "output_threshold_db": -50.0, "input_threshold_db": -40.0,
    "input_sustain_ms": 100.0, "hold": 1.5, "attack": 0.15, "release": 1.0, "easing": "smooth",
    "config": default_config_path(), "calibrate": None, "calibrate_guided": False,
    "calibrate_seconds": 10.0, "no_save": False, "save_config": False,
    "show_config": False, "list": False, "debug": False,
}


class ConfigError(Exception):
    pass


def dest_of(key):
    return key.replace("-", "_")


def read_config(path):
    """Return {dest: value} from the config file; {} if it doesn't exist."""
    cp = configparser.ConfigParser(interpolation=None)
    try:
        cp.read(path)
    except configparser.Error as e:
        raise ConfigError(f"{path}: {e}")
    out = {}
    if not cp.has_section(CONFIG_SECTION):
        return out
    for key, raw in cp[CONFIG_SECTION].items():
        typ = CONFIG_KEYS.get(key)
        if typ is None:
            print(f"pw-duck: {path}: ignoring unknown setting '{key}'", file=sys.stderr, flush=True)
            continue
        try:
            out[dest_of(key)] = ([x.strip() for x in raw.split(",") if x.strip()] if typ is list else typ(raw))
        except ValueError:
            raise ConfigError(f"{path}: bad value for '{key}': {raw!r}")
    if out.get("easing", "smooth") not in EASINGS:
        raise ConfigError(f"{path}: easing must be one of {sorted(EASINGS)}")
    return out


def save_config(path, updates):
    """Merge {key: value} into the config file (keeps other settings), atomically."""
    cp = configparser.ConfigParser(interpolation=None)
    cp.read(path)
    if not cp.has_section(CONFIG_SECTION):
        cp.add_section(CONFIG_SECTION)
    for key, value in updates.items():
        cp[CONFIG_SECTION][key] = ", ".join(value) if isinstance(value, list) else f"{value:g}" if isinstance(value, float) else str(value)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write("# pw-duck settings. Written by `pw-duck --save-config` / `--calibrate-guided`; safe to edit.\n")
        cp.write(f)
    os.replace(tmp, path)


def config_updates_from_cli(cli, keys=None):
    """The config-able settings the user passed explicitly on the command line."""
    return {k: cli[dest_of(k)] for k in CONFIG_KEYS if dest_of(k) in cli and (keys is None or k in keys)}


def resolve(cli):
    """Defaults < config file < command line."""
    values = dict(DEFAULTS)
    values.update(read_config(cli.get("config", DEFAULTS["config"])))
    values.update(cli)
    return argparse.Namespace(**values)


def file_mtime(path):
    try:
        return os.stat(path).st_mtime
    except OSError:
        return None


def pactl_json(*args):
    out = subprocess.run(["pactl", "-f", "json", *args],
                         capture_output=True, text=True, check=True).stdout
    return json.loads(out)


def props(item):
    return item.get("properties", {})


def matches(item, query):
    """Case-insensitive match on application.name (substring) or process binary (exact)."""
    q = query.lower()
    p = props(item)
    return q in p.get("application.name", "").lower() or q == p.get("application.process.binary", "").lower()


def peak_raw(item):
    return max(v["value"] for v in item["volume"].values())


class Level:
    """Runs parec on one stream/device and records when it was last above threshold.

    `sustained_db` is the lowest chunk level over the last `sustain_chunks` chunks, i.e. the
    level that was held for the whole window. Short clicks (keystrokes) don't survive it.
    """

    def __init__(self, cmd, threshold_db, sustain_chunks=1, record=False):
        self.threshold_db = threshold_db
        self.last_active = 0.0
        self.db = -120.0
        self.sustained_db = -120.0
        self._recent = collections.deque(maxlen=max(1, sustain_chunks))
        self.trace = [] if record else None       # [(db, sustained_db)] per chunk
        self.proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        while True:
            data = self.proc.stdout.read(CHUNK_BYTES)
            if len(data) < CHUNK_BYTES:
                return
            samples = array.array("h")
            samples.frombytes(data)
            # Remove DC offset first: some mics idle at a constant non-zero level that
            # would otherwise read as permanent "sound".
            mean = sum(samples) / len(samples)
            rms = math.sqrt(sum((s - mean) ** 2 for s in samples) / len(samples)) / 32768
            self.db = 20 * math.log10(rms) if rms > 0 else -120.0
            self._recent.append(self.db)
            full = len(self._recent) == self._recent.maxlen
            self.sustained_db = min(self._recent) if full else -120.0
            if self.trace is not None:
                self.trace.append((self.db, self.sustained_db))
            if self.sustained_db > self.threshold_db:
                self.last_active = time.monotonic()

    def alive(self):
        return self.proc.poll() is None

    def stop(self):
        if self.alive():
            self.proc.terminate()


def parec_cmd(device, monitor_stream=None):
    cmd = ["parec", f"--device={device}", "--format=s16le", f"--rate={RATE}",
           "--channels=1", f"--latency-msec={CHUNK_MS}"]
    if monitor_stream is not None:
        cmd.append(f"--monitor-stream={monitor_stream}")
    return cmd


def list_streams():
    for title, kind in (("Playback streams (--output / --target)", "sink-inputs"),
                        ("Capture streams (--input)", "source-outputs")):
        print(title)
        for i in pactl_json("list", kind):
            p = props(i)
            vol = f"{round(peak_raw(i) / 655.36)}%" if i.get("volume") else "?"
            print(f"  #{i['index']:<6} name={p.get('application.name', '?')!r:<28} "
                  f"binary={p.get('application.process.binary', '?')!r:<20} vol={vol}")
    print("Capture devices (--input-device)")
    for s in pactl_json("list", "sources"):
        if not s["name"].endswith(".monitor"):
            print(f"  {s['name']}  [{s['state']}]")


def source_for_app(app, sources):
    """Names of the capture sources an app is currently recording from."""
    return [sources[o["source"]] for o in pactl_json("list", "source-outputs")
            if matches(o, app) and o["source"] in sources]


def input_device(args):
    """First capture device to measure: an input device, else an input app's source."""
    sources = {s["index"]: s["name"] for s in pactl_json("list", "sources")}
    devices = list(args.input_device)
    for app in args.input:
        devices += source_for_app(app, sources)
    if not devices:
        print("No input to measure: set `input` in the config or pass --input APP (the app needs a "
              "capture stream open, e.g. join the call) or --input-device. See `pw-duck --list`.",
              file=sys.stderr)
    return devices[0] if devices else None


def sustain_chunks_for(args):
    return max(1, round(args.input_sustain_ms / CHUNK_MS))


def measure(device, seconds, sustain_chunks):
    """Record per-chunk levels for `seconds`; returns [(db, sustained_db)]."""
    lvl = Level(parec_cmd(device), 0.0, sustain_chunks, record=True)
    time.sleep(0.3)
    lvl.trace.clear()                      # drop start-up chunks
    time.sleep(seconds)
    lvl.stop()
    time.sleep(0.1)
    return list(lvl.trace)


def pick(sorted_vals, p):
    return sorted_vals[min(len(sorted_vals) - 1, int(p * len(sorted_vals)))]


def percentile_line(values):
    v = sorted(values)
    return "  ".join(f"p{int(p * 100)}={pick(v, p):6.1f}" for p in (0.05, 0.25, 0.5, 0.75, 0.9, 0.99)) + f"  max={v[-1]:6.1f}"


def frac_above(values, threshold):
    return sum(1 for x in values if x > threshold) / len(values)


def calibrate(args):
    """Measure the input for N seconds and print instantaneous and sustained level percentiles."""
    dev = input_device(args)
    if dev is None:
        return 1
    trace = measure(dev, args.calibrate, sustain_chunks_for(args))
    print(f"source: {dev}\n{len(trace)} chunks over {args.calibrate:g}s (dBFS RMS per {CHUNK_MS} ms)")
    print(f"  instant:   {percentile_line([t[0] for t in trace])}")
    print(f"  sustained: {percentile_line([t[1] for t in trace])}   (held for {args.input_sustain_ms:g} ms)")
    return 0


def cue(message, lead=3.0):
    """Tell the user what to do next: terminal line, desktop notification, and a sound."""
    print(f"\n>>> {message} (starts in {lead:g}s)", flush=True)
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-u", "critical", "-t", str(int(lead * 1000)), "pw-duck calibration",
                        f"{message} (starts in {lead:g}s)"], stderr=subprocess.DEVNULL)
    time.sleep(lead)
    bell = "/usr/share/sounds/freedesktop/stereo/message.oga"
    if shutil.which("paplay") and os.path.exists(bell):
        subprocess.run(["paplay", bell], stderr=subprocess.DEVNULL)


def calibrate_guided(args, cli):
    """Two measured phases (noise you want ignored, then speech); saves the threshold to the config."""
    dev = input_device(args)
    if dev is None:
        return 1
    n = sustain_chunks_for(args)
    secs = args.calibrate_seconds
    print(f"source: {dev}  |  sustain window {args.input_sustain_ms:g} ms  |  {secs:g}s per phase")
    cue("PHASE 1: do your normal background noise, e.g. type, but do NOT talk")
    noise = measure(dev, secs, n)
    cue("PHASE 2: talk normally, as you would on the call")
    speech = measure(dev, secs, n)
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-t", "3000", "pw-duck calibration", "Done"], stderr=subprocess.DEVNULL)

    print("\nsustained level (dBFS RMS):")
    print(f"  noise:  {percentile_line([t[1] for t in noise])}")
    print(f"  speech: {percentile_line([t[1] for t in speech])}")
    noise_s = sorted(t[1] for t in noise)
    speech_s = [t[1] for t in speech]
    threshold = round(pick(noise_s, 0.995) + 1.5, 1)
    noise_hit, speech_hit = frac_above(noise_s, threshold), frac_above(speech_s, threshold)
    print(f"\nsuggested: input-threshold-db = {threshold:g}, input-sustain-ms = {args.input_sustain_ms:g}")
    print(f"  background noise above it: {noise_hit:.1%} of chunks")
    print(f"  speech above it:           {speech_hit:.1%} of chunks "
          f"(--hold {args.hold:g}s bridges the gaps between words)")
    if speech_hit < 0.15:
        print("\nwarning: very little of your speech clears the noise, so nothing was saved. Try a longer "
              "--input-sustain-ms (typing clicks are short, speech is sustained), or use --output only.",
              file=sys.stderr)
        return 1
    if args.no_save:
        print("\n--no-save given: config not changed.")
        return 0
    updates = {"input-threshold-db": threshold, "input-sustain-ms": args.input_sustain_ms}
    updates.update(config_updates_from_cli(cli, keys=("input", "input-device")))
    save_config(args.config, updates)
    print(f"\nsaved {', '.join(updates)} to {args.config}\n"
          "A running pw-duck reloads it within a second. Re-run this command any time to recalibrate.")
    return 0


def show_config(args, cli):
    file_values = read_config(args.config) if file_mtime(args.config) else {}
    print(f"config file: {args.config}" + ("" if file_mtime(args.config) else "  (does not exist yet)"))
    for key in CONFIG_KEYS:
        d = dest_of(key)
        source = "command line" if d in cli else "config file" if d in file_values else "default"
        value = getattr(args, d)
        print(f"  {key:<20} = {', '.join(value) if isinstance(value, list) else value}   [{source}]")


def build_parser():
    # argument_default=SUPPRESS: only options actually given end up in the namespace, so the
    # command line can be layered over the config file and the defaults.
    ap = argparse.ArgumentParser(
        prog="pw-duck", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
        argument_default=argparse.SUPPRESS)
    ap.add_argument("--config", metavar="FILE", help=f"config file (default {default_config_path()})")
    ap.add_argument("--target", action="append", metavar="APP",
                    help="app to duck (repeatable). Matches application.name or process binary")
    ap.add_argument("--output", action="append", metavar="APP",
                    help="duck while APP's playback is audible (repeatable)")
    ap.add_argument("--input", action="append", metavar="APP",
                    help="duck while the mic APP is recording from is loud (repeatable)")
    ap.add_argument("--input-device", action="append", metavar="SOURCE",
                    help="duck while this capture device is loud, e.g. @DEFAULT_SOURCE@. Always opened, "
                         "which can switch a Bluetooth headset to its headset profile")
    ap.add_argument("--duck-db", type=float, help="how far to duck, in dB (default -12)")
    ap.add_argument("--output-threshold-db", type=float,
                    help="dBFS RMS that counts as playback sound (default -50)")
    ap.add_argument("--input-threshold-db", type=float,
                    help="dBFS RMS that counts as you speaking (default -40; see --calibrate-guided)")
    ap.add_argument("--input-sustain-ms", type=float,
                    help="the input must stay above its threshold this long to count, which ignores "
                         "short clicks like keystrokes (default 100)")
    ap.add_argument("--hold", type=float, help="seconds to stay ducked after sound stops (default 1.5)")
    ap.add_argument("--attack", type=float, help="seconds to duck down (default 0.15)")
    ap.add_argument("--release", type=float, help="seconds to fade back up (default 1.0)")
    ap.add_argument("--easing", choices=sorted(EASINGS),
                    help="fade curve (default smooth; linear is a straight ramp in dB)")
    ap.add_argument("--calibrate-guided", action="store_true",
                    help="guided two-phase calibration (background noise, then speech); saves the "
                         "threshold to the config")
    ap.add_argument("--calibrate-seconds", type=float, metavar="SECONDS",
                    help="length of each --calibrate-guided phase (default 10)")
    ap.add_argument("--no-save", action="store_true", help="with --calibrate-guided: don't write the config")
    ap.add_argument("--calibrate", type=float, metavar="SECONDS",
                    help="measure the input for SECONDS and print level percentiles, exit (saves nothing)")
    ap.add_argument("--save-config", action="store_true",
                    help="write the settings given on this command line to the config file, then exit")
    ap.add_argument("--show-config", action="store_true",
                    help="print the effective settings and where each comes from, then exit")
    ap.add_argument("--list", action="store_true", help="list playback/capture streams and capture devices, then exit")
    ap.add_argument("--debug", action="store_true", help="print levels (instant/sustained) and gain twice a second")
    return ap


def main(argv=None):
    ap = build_parser()
    cli = vars(ap.parse_args(argv))
    try:
        args = resolve(cli)
    except ConfigError as e:
        print(f"pw-duck: {e}", file=sys.stderr)
        return 2

    if args.list:
        list_streams()
        return 0
    if args.show_config:
        show_config(args, cli)
        return 0
    if args.save_config:
        updates = config_updates_from_cli(cli)
        if not updates:
            ap.error("--save-config needs at least one setting on the command line")
        save_config(args.config, updates)
        print(f"saved {', '.join(updates)} to {args.config}")
        return 0
    if args.calibrate_guided:
        return calibrate_guided(args, cli)
    if args.calibrate:
        return calibrate(args)
    if not args.target:
        ap.error(f"no target: pass --target APP or set `target` in {args.config}")
    if not (args.output or args.input or args.input_device):
        ap.error(f"nothing to watch: pass --output / --input / --input-device or set them in {args.config}")

    running = True

    def stop(*_):
        nonlocal running
        running = False

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    watchers = {}      # key -> Level; key prefix says what it is: out: / in: / dev:
    targets = {}       # sink-input index -> raw volume at 0 dB of ducking
    gain_db = 0.0      # current ducking, 0 .. duck_db (shared by all targets)
    ease = EASINGS[args.easing]
    cfg_mtime = file_mtime(args.config)

    def raw_for(base, gain):
        # PulseAudio/PipeWire volumes are cubic: dB = 60 * log10(raw ratio).
        return max(1, round(base * 10 ** (gain / 60)))

    def set_volumes(items):
        # Launch all updates together, then wait, so several targets fade in step.
        procs = [subprocess.Popen(["pactl", "set-sink-input-volume", str(idx), str(raw)],
                                  stderr=subprocess.DEVNULL) for idx, raw in items]
        for p in procs:
            p.wait()

    def apply_gain():
        set_volumes([(idx, raw_for(base, gain_db)) for idx, base in targets.items()])

    def reload_config():
        nonlocal args, ease, cfg_mtime
        mtime = file_mtime(args.config)
        if mtime == cfg_mtime:
            return
        cfg_mtime = mtime
        try:
            new = resolve(cli)
        except ConfigError as e:
            print(f"pw-duck: ignoring config change: {e}", file=sys.stderr, flush=True)
            return
        args = new
        ease = EASINGS[args.easing]
        for w in watchers.values():          # thresholds are baked into watchers; scan() recreates them
            w.stop()
        watchers.clear()
        print("pw-duck: config reloaded", file=sys.stderr, flush=True)

    def scan():
        reload_config()
        inputs = pactl_json("list", "sink-inputs")
        sinks = {s["index"]: s["name"] for s in pactl_json("list", "sinks")}
        sources = {s["index"]: s["name"] for s in pactl_json("list", "sources")}

        # Targets: track each matching stream's un-ducked volume.
        seen = set()
        for i in inputs:
            if not any(matches(i, t) for t in args.target):
                continue
            idx, cur = i["index"], peak_raw(i)
            seen.add(idx)
            if idx not in targets:
                targets[idx] = cur
                if gain_db < 0:                       # appeared mid-duck
                    apply_gain()
            elif abs(cur - raw_for(targets[idx], gain_db)) > 0.02 * 65536:
                targets[idx] = cur / 10 ** (gain_db / 60)   # user moved the slider: adopt it
        existing = {i["index"] for i in inputs}
        for idx in list(targets):
            if idx not in seen:
                if idx in existing and gain_db < 0:       # no longer a target (config change): un-duck it
                    set_volumes([(idx, round(targets[idx]))])
                del targets[idx]

        wanted = {}
        for i in inputs:
            if i["sink"] in sinks and any(matches(i, o) for o in args.output):
                wanted[f"out:{i['index']}"] = (parec_cmd(sinks[i["sink"]] + ".monitor", i["index"]),
                                               args.output_threshold_db, 1)
        # An input app is tapped at whichever source it is actually capturing from, and only while
        # it has a capture stream open (so we never wake a Bluetooth mic on our own).
        for app in args.input:
            for src in source_for_app(app, sources):
                wanted[f"in:{src}"] = (parec_cmd(src), args.input_threshold_db, sustain_chunks_for(args))
        for dev in args.input_device:
            wanted[f"dev:{dev}"] = (parec_cmd(dev), args.input_threshold_db, sustain_chunks_for(args))

        for key in list(watchers):
            if key not in wanted or not watchers[key].alive():
                watchers.pop(key).stop()
        for key, (cmd, thr, sustain_n) in wanted.items():
            if key not in watchers:
                watchers[key] = Level(cmd, thr, sustain_n)

    ramp = None            # (start_time, duration, from_db, to_db) while fading
    ramp_goal = 0.0        # the goal the current ramp (or rest state) is heading to
    last_scan = last_debug = 0.0
    try:
        while running:
            now = time.monotonic()
            if now - last_scan >= SCAN_EVERY:
                try:
                    scan()
                except (subprocess.CalledProcessError, json.JSONDecodeError, KeyError) as e:
                    print(f"pw-duck: scan failed ({e!r}); retrying", file=sys.stderr, flush=True)
                last_scan = now

            active = any(now - w.last_active < args.hold for w in watchers.values())
            goal = args.duck_db if active else 0.0
            if goal != ramp_goal:
                # New direction (or first duck): ease from the current gain. Duration scales with
                # the distance left, so a reversal mid-fade doesn't take a full attack/release.
                ramp_goal = goal
                secs = args.attack if goal < gain_db else args.release
                dur = secs * abs(goal - gain_db) / max(abs(args.duck_db), 1e-9)
                ramp = (now, dur, gain_db, goal)
            if ramp:
                t0, dur, g0, g1 = ramp
                f = 1.0 if dur <= 0 else min(1.0, (now - t0) / dur)
                gain_db = g0 + (g1 - g0) * ease(f)
                if targets:
                    apply_gain()
                if f >= 1.0:
                    ramp = None

            if args.debug and now - last_debug >= 0.5:
                levels = " ".join(f"{k}={w.db:6.1f}/{w.sustained_db:6.1f}dB" for k, w in sorted(watchers.items())) \
                    or "(nothing to watch)"
                print(f"{levels}  active={active}  gain={gain_db:6.1f}dB  targets={sorted(targets) or 'none'}",
                      flush=True)
                last_debug = now

            time.sleep(RAMP_TICK if ramp else TICK)
    finally:
        for w in watchers.values():
            w.stop()
        gain_db = 0.0
        apply_gain()
    return 0


if __name__ == "__main__":
    sys.exit(main())
