[Unit]
Description=pw-duck sidechain ducking
After=pipewire-pulse.service
Wants=pipewire-pulse.service

[Service]
# Settings come from ~/.config/pw-duck/config.ini and are reloaded when that file changes.
# Add command-line options here only to override the file.
ExecStart=%h/.local/bin/pw-duck
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
